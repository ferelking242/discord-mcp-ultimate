# Copy this file to .env and fill in your token. Never commit the result.
# .env is in .gitignore. This template contains no secret.

# Required. Discord bot token from https://discord.com/developers/applications
# -> your application -> Bot -> Reset Token.
DISCORD_TOKEN=your_bot_token_here

# Privileged gateway intents requested at connect time (default: true).
# Set to false if the matching toggle is off in the Developer Portal, otherwise
# Discord closes the connection with code 4014.
#
# DISCORD_MESSAGE_CONTENT=false also removes the ability to read message bodies,
# which is worth doing for an agent whose job is server administration rather
# than conversation: it closes off the main prompt-injection surface.
# DISCORD_MESSAGE_CONTENT=true
# DISCORD_GUILD_MEMBERS=true

# Restrict the server to specific guild IDs (comma-separated). When set, calls
# addressed by guild, channel, thread, webhook or invite outside the list fail
# at argument-validation time, before a handler runs.
# DISCORD_ALLOWED_GUILDS=123456789012345678,234567890123456789

# Expose only selected toolsets (comma-separated; `all` or unset = everything).
# Unknown names abort startup. Fewer tools means less for a model to choose
# between, which is the single most effective reliability setting here.
#
# Available:
#   discovery, messages, channels, permissions, members, roles, moderation,
#   screening, stats, forums, webhooks, scheduled_events, invites, dm,
#   guild_settings, bot_profile, style, architect, automod, expressions,
#   backup, diagnostics, scheduler, reaction_roles
#
# Example: the tools a server-building agent needs, and nothing else.
# DISCORD_MCP_TOOLSETS=discovery,channels,roles,permissions,style,architect,guild_settings

# ─────────────────────────────────────────────────────────────────────────────
# Long-running bot (npm run bot)
#
# The bot and the MCP server share one Discord gateway connection. Start the bot
# when you want reaction roles, welcome DMs, or a remote HTTP MCP endpoint.
# ─────────────────────────────────────────────────────────────────────────────

# Reaction events. Required by the bot, off by default for the stdio server.
# Needs the "Message Content" and "Guild Members" privileged intents in the
# Developer Portal if DISCORD_MESSAGE_CONTENT / DISCORD_GUILD_MEMBERS are on.
# DISCORD_REACTION_INTENTS=true

# Where reaction-role menus are stored. The bot watches this file, so a menu
# built through an MCP tool call takes effect without a restart.
# BOT_REACTION_ROLES_FILE=.data/reaction-roles.json

# toggle = removing the reaction removes the role (default).
# add-only = a role, once granted, is never removed by unreacting.
# BOT_REACTION_MODE=toggle

# Per-member reaction actions allowed inside the window, and the window itself.
# One member cannot rate-limit the bot for everyone else.
# BOT_REACTION_LIMIT=10
# BOT_REACTION_WINDOW_MS=10000

# DM every new member. Off by default: an unexpected DM reads as spam.
# BOT_WELCOME_DM=false
# BOT_WELCOME_MESSAGE=Welcome to the server!
# BOT_INVITE_URL=https://discord.gg/your-invite

# Presence text under the bot name.
# BOT_STATUS=Watchtower

# ─────────────────────────────────────────────────────────────────────────────
# MCP over HTTP (for a server deployment, or a client that cannot spawn stdio)
#
# Off unless MCP_HTTP_ENABLED=true. MCP_HTTP_TOKEN is then mandatory: the port
# holds a bot token and the full destructive tool surface, so it must never be
# reachable without authentication. Put it behind TLS (a reverse proxy) if the
# client is not on the same host — the bearer token is sent in clear over http.
# ─────────────────────────────────────────────────────────────────────────────
# MCP_HTTP_ENABLED=true
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000
# MCP_HTTP_TOKEN=generate_a_long_random_string_here

# Data directory for every state file (guild config, tickets, levels, giveaways,
# starboard, moderation cases, temporary voice channels). One folder to back up,
# one path to mount as a Docker volume.
# BOT_DATA_DIR=.data

# Slash commands: registered to this guild only, which applies immediately.
# Unset registers them globally, which Discord can take up to an hour to show.
# DISCORD_DEV_GUILD=123456789012345678

# Extra roles allowed to run operator commands, comma-separated.
# DISCORD_ADMIN_ROLES=123456789012345678,234567890123456789

