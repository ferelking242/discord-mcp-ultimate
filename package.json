{
  "name": "discord-mcp-ultimate",
  "version": "3.0.0",
  "mcpName": "io.github.ferelking242/discord-mcp-ultimate",
  "description": "A Discord MCP server with 172 tools: full server administration, Unicode name styling, a resumable server architect, AutoMod, emoji and sticker management, structure backup, diagnostics and a safety layer with preview-before-apply",
  "main": "dist/index.js",
  "type": "commonjs",
  "bin": {
    "discord-mcp-ultimate": "dist/index.js",
    "discord-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "SECURITY.md",
    "Dockerfile",
    "docs",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test test/*.test.ts",
    "version": "node scripts/sync-version.js && git add server.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "discord",
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "bot",
    "discord-bot",
    "cursor",
    "windsurf",
    "claude-desktop"
  ],
  "author": "ferelking242 (fork of PaSympa/discord-mcp by L\u00e9andre Moreau)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ferelking242/discord-mcp-ultimate"
  },
  "homepage": "https://github.com/ferelking242/discord-mcp-ultimate#readme",
  "bugs": {
    "url": "https://github.com/ferelking242/discord-mcp-ultimate/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "discord.js": "^14.26.4",
    "dotenv": "^18.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.60.0"
  }
}
